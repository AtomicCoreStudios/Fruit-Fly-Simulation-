# Godot / Python environments
.godot/
.venv/
__pycache__/
*.pyc

# Raw data: re-download with tools/fetch_data.py (pinned by checksum)
data/raw/
assets/flyvis/

# Large derived data: rebuild with the tools (see README "Rebuild from a fresh clone")
data/connectome_*.bin
data/graded_net.npz
data/graded_gpu.bin
data/lif_w_graded.bin
data/flyvis_net.npz
data/flyvis_gpu.bin

# Blender autosaves
*.blend1

# Godot translation junk generated from CSVs
*.translation

# junk Godot generated by importing a recording CSV as translations (before recordings/.gdignore)
recordings/flywire_opto.
recordings/flywire_opto.ascending
recordings/flywire_opto.central
recordings/flywire_opto.descending
recordings/flywire_opto.endocrine
recordings/flywire_opto.motor
recordings/flywire_opto.optic
data/*.csv.import
